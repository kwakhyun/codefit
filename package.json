{
  "name": "codefit-coding-gym",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-monaco-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "node scripts/backup-database.mjs",
    "test:api": "node scripts/verify-api.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:unused": "knip",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "eval:ai": "node --import tsx scripts/evaluate-ai.ts",
    "eval:generation": "node --import tsx scripts/evaluate-generation.ts",
    "test:e2e": "playwright test",
    "benchmark": "node --import tsx scripts/benchmark-storage.ts",
    "measure:browser": "node --import tsx scripts/measure-browser.ts",
    "test:ai-live": "node --import tsx scripts/verify-live-ai.ts",
    "measure:interactions": "node --import tsx scripts/measure-interactions.mjs",
    "measure:typing-pair": "node scripts/measure-typing-pair.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "better-auth": "^1.7.4",
    "lucide-react": "^1.39.0",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.4",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "better-call": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.14"
  },
  "engines": {
    "node": "22.x"
  }
}
