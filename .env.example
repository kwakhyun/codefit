# Server-only. Without a key, existing problems, editing, hints and backups still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Local persistent storage. Leave DATABASE_URL unset to use SQLite.
# DATABASE_PATH=/data/recode.sqlite

# Required on Vercel. Use separate Production and Preview PostgreSQL databases.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Required on Vercel for privacy-preserving network rate limits. Use a random secret.
RATE_LIMIT_SALT=

# Public HTTPS origin when a reverse proxy changes the request origin.
# APP_ORIGIN=https://lab.example.com
