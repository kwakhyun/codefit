# Existing OpenAI integration. Never put credentials in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Persistent disk path. Default: ./data/recode.sqlite
# DATABASE_PATH=/data/recode.sqlite

# Required for npm start / Docker production runs. Use a long random passphrase.
LAB_ACCESS_TOKEN=
# Public HTTPS origin, required when a reverse proxy changes the request origin.
# APP_ORIGIN=https://lab.example.com

# Vercel / PostgreSQL: required for cloud deployment. Leave unset for local SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
